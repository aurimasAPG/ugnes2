  "dialogue": [
    {
      "id": "dlg.orrel",
      "nodes": [
        {
          "id": "offer_countings",
          "speaker": "npc.orrel",
          "lines": [
            "Orrel does not stop writing.",
            "\"You walk the shelf. Good. I need a number and I need it twice.\"",
            "\"The sunmoss on the shaded bank. How many are open at dawn, and how many at dusk.\""
          ],
          "choices": [
            {
              "text": "Why twice?",
              "effects": [ { "type": "start_quest", "quest": "quest.countings" } ],
              "goto": "countings_why"
            },
            {
              "text": "Dawn and dusk. Fine.",
              "effects": [ { "type": "start_quest", "quest": "quest.countings" } ],
              "goto": "countings_detail"
            }
          ]
        },
        {
          "id": "countings_why",
          "speaker": "npc.orrel",
          "lines": [
            "\"Because one number is an opinion.\"",
            "She finally looks up.",
            "\"Everyone here says the moss is worthless because it grows wrong. Nobody has counted it. I would like to be the one holding the count when that stops being true.\""
          ],
          "goto": "countings_detail"
        },
        {
          "id": "countings_detail",
          "speaker": "npc.orrel",
          "lines": [
            "\"Shaded bank, off the upper shelf. Dawn first, then dusk — in that order, or the second number means nothing.\""
          ]
        },
        {
          "id": "take_counts",
          "speaker": "npc.orrel",
          "lines": [ "\"Well? Both of them.\"" ],
          "choices": [
            {
              "text": "Both counted. Dusk was the bigger number.",
              "effects": [ { "type": "advance_quest", "quest": "quest.countings" } ],
              "goto": "counts_result"
            },
            { "text": "Not finished yet." }
          ]
        },
        {
          "id": "counts_result",
          "speaker": "npc.orrel",
          "lines": [
            "She writes it down, underlines it, and sits back.",
            "\"Four times the yield at dusk. Four. And every carter who comes through this valley collects at noon because that is when carters like to work.\"",
            "\"Right. I'm opening a post on the west bank, and I am buying moss at dusk prices.\"",
            "\"Tell people. Tell them I said the number.\""
          ]
        },
        {
          "id": "offer_ledger",
          "speaker": "npc.orrel",
          "lines": [
            "\"The post is standing and nobody has used it, which makes it a shed.\"",
            "\"Bring me moss across my own counter until I have three slips written. Then it is a trade post.\""
          ],
          "choices": [
            {
              "text": "Three slips.",
              "effects": [ { "type": "start_quest", "quest": "quest.ledger" } ],
              "goto": "ledger_detail"
            },
            { "text": "It's a shed." }
          ]
        },
        {
          "id": "ledger_detail",
          "speaker": "npc.orrel",
          "lines": [
            "\"Two moss a slip. I am not being generous — I am establishing a rate, and the first rate is the one that sticks.\""
          ]
        },
        {
          "id": "take_ledger",
          "speaker": "npc.orrel",
          "lines": [ "\"Slips.\"" ],
          "choices": [
            {
              "text": "Three of them.",
              "when": { "type": "has_item", "item": "item.ledger_slip", "count": 3 },
              "effects": [ { "type": "advance_quest", "quest": "quest.ledger" } ],
              "goto": "ledger_done"
            },
            { "text": "Working on it." }
          ]
        },
        {
          "id": "ledger_done",
          "speaker": "npc.orrel",
          "lines": [
            "She takes all three, files them, and writes a fourth thing that she does not show you.",
            "\"That is a trading post with a history now. Small history. Still a history.\""
          ]
        },
        {
          "id": "cart_talk",
          "speaker": "npc.orrel",
          "lines": [
            "\"It has been a wall my whole life and this morning it is a road.\"",
            "\"Take the other handle. And keep it slow on the cut — a loaded cart on a slope stops being yours very quickly.\""
          ]
        },
        {
          "id": "idle",
          "speaker": "npc.orrel",
          "lines": [
            "\"I am three columns from a total. Come back when I am four.\""
          ]
        }
      ]
    }
  ]
}
