{
  "npcs": [
    {
      "id": "npc.orrel",
      "name": "Orrel",
      "region": "heartwood",
      "capability_kind": "world_contents",
      "schedule": [
        { "from": "dawn", "to": "dusk", "waypoint": "wp.ledger_house" },
        { "from": "night", "to": "night", "waypoint": "wp.ledger_upstairs" }
      ],
      "dialogue_entries": [
        {
          "dialogue": "dlg.orrel",
          "node": "take_counts",
          "when": { "type": "quest_step", "quest": "quest.countings", "step": "report", "compare": "at" }
        },
        {
          "dialogue": "dlg.orrel",
          "node": "offer_countings",
          "when": { "type": "quest_state", "quest": "quest.countings", "state": "notstarted" }
        },
        {
          "dialogue": "dlg.orrel",
          "node": "take_ledger",
          "when": { "type": "quest_step", "quest": "quest.ledger", "step": "report", "compare": "at" }
        },
        {
          "dialogue": "dlg.orrel",
          "node": "offer_ledger",
          "when": {
            "type": "all",
            "of": [
              { "type": "quest_state", "quest": "quest.countings", "state": "completed" },
              { "type": "quest_state", "quest": "quest.ledger", "state": "notstarted" }
            ]
          }
        },
        {
          "dialogue": "dlg.orrel",
          "node": "cart_talk",
          "when": { "type": "quest_state", "quest": "quest.cart", "state": "active" }
        },
        { "dialogue": "dlg.orrel", "node": "idle" }
      ]
    }
  ],

  "quests": [
    {
      "id": "quest.countings",
      "title": "Countings",
      "shape": "observe-and-report",
      "giver": "npc.orrel",
      "summary": "Orrel wants a number, twice, at the right hours. She will not say what for until she has it.",
      "steps": [
        {
          "id": "dawn_count",
          "tracker": "Count the open sunmoss on the shaded bank at dawn.",
          "completion": [
            { "id": "counted_dawn", "when": { "type": "flag", "key": "count.dawn", "value": "true" } }
          ]
        },
        {
          "id": "dusk_count",
          "tracker": "Count them again at dusk. The number is the point, not the moss.",
          "completion": [
            { "id": "counted_dusk", "when": { "type": "flag", "key": "count.dusk", "value": "true" } }
          ]
        },
        {
          "id": "report",
          "tracker": "Take both counts to Orrel at the ledger house.",
          "completion": []
        }
      ],
      "on_complete": [
        { "type": "set_flag", "key": "orrel.tradepost", "value": "true" }
      ]
    },

    {
      "id": "quest.ledger",
      "title": "The Long Ledger",
      "shape": "trade",
      "giver": "npc.orrel",
      "summary": "A trade post is only a claim until something has actually changed hands across it.",
      "steps": [
        {
          "id": "trade",
          "tracker": "Trade sunmoss at the Trade Post until you hold three ledger slips.",
          "completion": [
            { "id": "traded", "when": { "type": "has_item", "item": "item.ledger_slip", "count": 3 } }
          ]
        },
        {
          "id": "report",
          "tracker": "Bring the three slips back to Orrel.",
          "completion": []
        }
      ],
      "on_complete": [
        { "type": "take_item", "item": "item.ledger_slip", "count": 3 },
        { "type": "set_flag", "key": "orrel.ledger_done", "value": "true" }
      ]
    },

    {
      "id": "quest.cart",
      "title": "Cart to the Shelf",
      "shape": "escort",
      "giver": "npc.orrel",
      "summary": "The lower shelf is open, which means for the first time in Orrel's life it is somewhere goods can go.",
      "start_when": {
        "type": "all",
        "of": [
          { "type": "quest_state", "quest": "quest.ledger", "state": "completed" },
          { "type": "flag", "key": "shelf.lower.open", "value": "true" }
        ]
      },
      "steps": [
        {
          "id": "start",
          "tracker": "Take the handcart's other handle outside the ledger house.",
          "completion": [
            { "id": "started", "when": { "type": "flag", "key": "cart.started", "value": "true" } }
          ]
        },
        {
          "id": "arrive",
          "tracker": "Walk the cart down to the lower shelf without letting it get away from you.",
          "completion": [
            { "id": "arrived", "when": { "type": "flag", "key": "cart.arrived", "value": "true" } }
          ]
        }
      ],
      "on_complete": [
        { "type": "set_flag", "key": "orrel.cart_done", "value": "true" },
        { "type": "give_item", "item": "item.ledger_slip", "count": 1 }
      ]
    }
  ],

